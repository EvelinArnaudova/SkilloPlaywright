                  "pm.test('saved the sent fields', () => pm.expect(post).to.include({ title: 'From Postman', published: false, authorId: 2 }));",
                  "pm.test('Location header points to the new post', () => pm.response.to.have.header('Location', '/api/posts/' + post.id));",
                  "pm.collectionVariables.set('postId', post.id);"
                ]
              }
            }
