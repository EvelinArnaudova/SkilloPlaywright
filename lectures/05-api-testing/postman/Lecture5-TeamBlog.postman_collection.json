  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before EVERY request. Requests that use the collection's Bearer auth need a token.",
          "// If there is none (you send one request on its own, or after Logout), sign in as QA first.",
          "const usesToken = !pm.request.auth || pm.request.auth.type !== 'noauth';",
          "if (usesToken && !pm.variables.get('token')) {",
          "  pm.sendRequest({",
          "    url: pm.variables.replaceIn('{{baseUrl}}/api/login'),",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: {",
          "      mode: 'raw',",
          "      raw: JSON.stringify({ email: pm.variables.get('qaEmail'), password: pm.variables.get('qaPassword') }),",
          "    },",
          "  }, (error, response) => {",
          "    if (error || response.code !== 200) {",
          "      console.error('Auto-login failed. Is the server running? npm run start:api');",
          "      return;",
          "    }",
          "    const token = response.json().token;",
          "    pm.collectionVariables.set('token', token);",
          "    // Local scope wins over an environment variable with the same name.",
          "    pm.variables.set('token', token);",
          "  });",
          "}"
        ]
      }
    }
  ]
