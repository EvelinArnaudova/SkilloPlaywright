                "exec": [
                  "pm.test('status is 200 (401 means no valid token was sent)', () => pm.response.to.have.status(200));",
                  "pm.test('is the QA user', () => pm.expect(pm.response.json().name).to.eql('Dev QA'));"
                ]
              }
